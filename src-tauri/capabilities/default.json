{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for nxCoder desktop",
  "windows": ["*"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/*",
      "http://127.0.0.1:*/**",
      "http://localhost:*",
      "http://localhost:*/*",
      "http://localhost:*/**"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-create",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "allow-spawn-window"
  ]
}
